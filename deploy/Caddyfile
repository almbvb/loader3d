# All values come from .env (passed into the container by docker-compose.yml).
#
# SITE_ADDRESS = domain (loader.example.com) -> Caddy obtains a Let's Encrypt certificate
#                and redirects HTTP to HTTPS; ports 80 and 443 must be reachable from the internet.
# SITE_ADDRESS = :80                          -> plain HTTP, e.g. behind an existing reverse proxy.
# Several names are allowed: "example.com, www.example.com".
# The text after the first colon in {$SITE_ADDRESS::80} is the fallback (":80").

{
	admin off
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Backend (backend/, the "api" service). Same origin as the frontend: no CORS, and the
	# refresh-token cookie stays first-party.
	handle /api/* {
		request_body {
			max_size 5MB
		}
		reverse_proxy api:8000
	}

	handle {
		root * /srv

		# Vite puts content-hashed bundles into /assets: safe to cache forever.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# Public images of the landing page: cached for a day.
		@landing path /landing/*
		header @landing Cache-Control "public, max-age=86400"

		# HTML must be revalidated so a new deploy is picked up immediately.
		@html path / /index.html /app.html
		header @html Cache-Control "no-cache"

		# index.html is the landing page prerendered for search engines (scripts/prerender.mjs);
		# every other route of the app gets the empty shell app.html.
		@root path /
		rewrite @root /index.html
		try_files {path} /app.html
		file_server
	}
}

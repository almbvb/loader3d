# Loader3D deployment settings. Copy to .env and edit:  cp .env.example .env
# .env is not committed (see .gitignore).

# --- Compose ------------------------------------------------------------------
# Prefix for the container, image and volume names.
COMPOSE_PROJECT_NAME=loader3d

# --- Site ---------------------------------------------------------------------
# Domain  -> automatic HTTPS (Let's Encrypt). The domain's DNS A/AAAA record must point
#            to this server and ports 80/443 must be open; keep HTTP_PORT=80, HTTPS_PORT=443.
#            Several names: SITE_ADDRESS="example.com, www.example.com"
# :80     -> plain HTTP without certificates (open by IP, or behind your own reverse proxy).
SITE_ADDRESS=:80

# --- Published ports ----------------------------------------------------------
# Host side of the port mapping: "PORT" or "IP:PORT".
# Behind an existing reverse proxy on the same host, publish on localhost only, e.g.
#   HTTP_PORT=127.0.0.1:8080
#   HTTPS_PORT=127.0.0.1:8443
# and proxy to http://127.0.0.1:8080 (keep SITE_ADDRESS=:80).
HTTP_PORT=80
HTTPS_PORT=443

# --- Accounts and sessions (api) ------------------------------------------------
# Required. Signs the login tokens: a random string of 32+ characters, e.g. the output of
#   openssl rand -hex 32
# Changing it logs everybody out.
JWT_SECRET=
# Lifetime of an access token (minutes) and of a login session without activity (days).
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# false: nobody can create new accounts (existing ones keep working).
REGISTRATION_OPEN=true
# The session cookie gets the Secure flag by itself when the site is opened over HTTPS.

# --- Database (Postgres) --------------------------------------------------------
# Required. Used when the database is created on the first start; changing it later does not
# change the password inside an existing database (docker compose exec db psql ... ALTER USER).
POSTGRES_PASSWORD=
POSTGRES_DB=loader3d
POSTGRES_USER=loader3d

# --- Container logs -----------------------------------------------------------
# Docker json-file log rotation: size of one file and how many files to keep.
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# --- Build --------------------------------------------------------------------
# Base image versions (Docker Hub tags node:<v>-alpine, caddy:<v>-alpine, python:<v>-slim).
# After changing them run: docker compose up -d --build
NODE_VERSION=24
CADDY_VERSION=2
PYTHON_VERSION=3.14
# Postgres major version (postgres:<v>-alpine). 18 or newer: the data volume layout depends on it.
# Changing the major version of an existing database needs a dump and restore.
POSTGRES_VERSION=18
